[Unit]
Description=RA Controller (backend, web UI and modules)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ra-controller
Group=ra-controller

# Update this path to match your actual installation directory.
WorkingDirectory=/opt/ra-controller

# Starts every module enabled in param.yaml and the backend, which also
# serves the web UI. Run "./server.sh build" once after installing or
# updating, so that this unit needs no toolchain.
ExecStart=/opt/ra-controller/server.sh

# Optional overrides — copy env.example to /etc/ra-controller/env and edit.
EnvironmentFile=-/etc/ra-controller/env

# Disable ANSI colour codes; systemd/journald handles plain text better.
Environment=NO_COLOR=1

# server.sh exits when any of its processes dies; restart the whole set.
Restart=on-failure
RestartSec=5

# Send SIGTERM to the main process only.
# server.sh's trap propagates the signal to all child processes.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
