# End host: plain Alpine with iproute2. No Polaris software.
#
# rio-shim is started only on kernels that cannot process Route Information
# Options themselves (see rio-shim/main.go and entrypoint-host.sh).
FROM golang:1.25-alpine AS shim
WORKDIR /src
COPY laboratory/rio-shim/go.mod laboratory/rio-shim/go.sum ./
RUN go mod download
COPY laboratory/rio-shim/ .
RUN CGO_ENABLED=0 go build -o /rio-shim .

FROM alpine:3.21
RUN apk add --no-cache iproute2 iputils
COPY --from=shim /rio-shim /usr/local/bin/rio-shim
COPY laboratory/entrypoint-host.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
